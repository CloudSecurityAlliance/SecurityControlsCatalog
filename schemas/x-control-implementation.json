{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CloudSecurityAlliance/SecurityControlsCatalog/refs/heads/main/schemas/x-control-implementation.json",
  "title": "x-control-implementation",
  "description": "A technology-agnostic approach to fulfilling a control, stated independently of any product or vendor. Vendor, product, and configuration detail belong to x-capability. Defined by the CSA Security Controls Catalog.",
  "type": "object",
  "required": ["type", "spec_version", "id", "created", "modified", "extensions"],
  "properties": {
    "type": { "const": "x-control-implementation" },
    "spec_version": { "const": "2.1" },
    "id": {
      "type": "string",
      "pattern": "^x-control-implementation--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "extensions": { "$ref": "#/$defs/newSdoExtension" },

    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },

    "implementation_type": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "stack_components": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "not": {
    "anyOf": [
      { "required": ["platform"] },
      { "required": ["product"] },
      { "required": ["vendor_namespace"] },
      { "required": ["config_snippet"] }
    ]
  },
  "$comment": "The `not` clause enforces the implementation/capability boundary: vendor, product, and configuration detail belong on x-capability, and an implementation approach that carries them has drifted into being a capability.",
  "$defs": {
    "newSdoExtension": {
      "type": "object",
      "description": "Declares the object as a new SDO defined by a CSA extension-definition. The definition object must travel with the instance in any published bundle.",
      "minProperties": 1,
      "patternProperties": {
        "^extension-definition--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$": {
          "type": "object",
          "required": ["extension_type"],
          "properties": { "extension_type": { "const": "new-sdo" } }
        }
      },
      "additionalProperties": false
    }
  }
}
